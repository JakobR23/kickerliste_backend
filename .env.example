# Root-level .env — used by Docker Compose.
# Copy to .env and fill in real values. This file is committed; .env is not.
#
# For local development without Docker, use env/.env instead (see env/.env.example).

DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=postgres
DB_PORT=5431
DB_NAME=postgres
HOST=0.0.0.0  # must be 0.0.0.0 in Docker so the server accepts external connections
PORT=8080
HASHSALT_LENGTH=16
JWT_SECRET=change-this-to-a-long-random-secret
APP_ENV=production
ALLOWED_ORIGINS=https://your-frontend-domain.com
